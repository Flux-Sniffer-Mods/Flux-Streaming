<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Streaming to Moonlight and AirPlay: the host runs while it's on, the screen and what's playing -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- The sound of what's playing, sent to Moonlight -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Found on the network by Moonlight and AirPlay TVs, kept on Wi-Fi while streaming -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Moonlight's Wake listened for from boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Termux:Widget's scripts in Moonlight's list -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".StreamingApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flux">

        <!-- Streaming: every app to open on the TV, and how it's streaming -->
        <activity
            android:name=".StreamingActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".StreamingSettingsActivity"
            android:exported="false" />
        <!-- The page for the TV's own screen, on the phone: its picture, keys and touch (Flux Gaming opens it too) -->
        <activity
            android:name=".ExtraScreenActivity"
            android:exported="true"
            android:permission="io.github.fluxsniffermods.permission.LINK"
            android:label="@string/extra_screen_title"
            android:taskAffinity="io.github.fluxsniffermods.fluxstreaming.screen"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- The Moonlight host, and the PIN typed to pair a device -->
        <service
            android:name=".StreamHostService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Game streaming host that Moonlight clients on the local network pair with" />
        </service>
        <activity
            android:name=".StreamPin"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The streaming notification tapped: end the stream or keep it -->
        <activity
            android:name=".StreamStop"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- A Moonlight client asking to stream, confirmed on the phone (started by the shell too: nothing without a request) -->
        <activity
            android:name=".StreamConfirm"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Started by the shell when Moonlight launches a game: does nothing without a session -->
        <activity
            android:name=".StreamCapture"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- AirPlay: casting to an Apple TV or AirPlay TV, and what it asks for first -->
        <service
            android:name=".airplay.AirPlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".airplay.AirPlayCapture"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Quick Settings: streaming on or off; a long-press opens its settings -->
        <service
            android:name=".StreamingTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_streaming"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <activity
            android:name=".StreamingTileSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Termux's answer when asked for Termux:Widget's scripts -->
        <receiver
            android:name=".TermuxScripts$Receiver"
            android:exported="false" />
        <receiver
            android:name=".StreamBoot"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The other Flux apps' way in: Flux Gaming's games on the TV, Flux Desktop's screen -->
        <provider
            android:name=".StreamingLink"
            android:authorities="${applicationId}.link"
            android:exported="true"
            android:permission="io.github.fluxsniffermods.permission.LINK" />
    </application>
</manifest>
